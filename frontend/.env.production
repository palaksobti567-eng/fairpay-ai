# Production environment variables
# Copy this file to .env.production.local for local production testing

# Backend API URL - change to your production backend URL
VITE_API_BASE_URL=https://your-backend-url.com

# PayPal Live Client ID - get from PayPal Developer Dashboard
VITE_PAYPAL_CLIENT_ID=your-paypal-live-client-id

# Always use live backend in production
VITE_USE_MOCK=false
