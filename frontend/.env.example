# Backend origin. Palak will share the Render URL later.
VITE_API_BASE_URL=http://localhost:3000

# Public PayPal client id only. Never put the client secret here.
VITE_PAYPAL_CLIENT_ID=

# true uses the in-browser demo API. false calls the backend above.
# You can also switch this from the sidebar; that choice is saved in the browser.
VITE_USE_MOCK=true
