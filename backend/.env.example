PORT=3000

# MongoDB Atlas connection string
MONGODB_URI=

# Auth
JWT_SECRET=

# Gemini (Google AI) - the AI SDK reads this exact variable name
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# PayPal (sandbox credentials from developer.paypal.com)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the PayPal dashboard for POST /api/payments/webhook
PAYPAL_WEBHOOK_ID=
# Sandbox by default; use https://api-m.paypal.com for live
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Kernel cloud browser API key (read-only verification screenshots)
KERNEL_API_KEY=

# Your deployed frontend URL, e.g. https://fairpay-ai-frontend.vercel.app
FRONTEND_URL=
